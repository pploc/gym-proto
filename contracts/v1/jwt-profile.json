{
  "algorithm": "RS256",
  "issuer": "gym-identifier",
  "audience": "gym-api",
  "requiredClaims": ["sub", "iss", "aud", "iat", "exp", "jti", "kid"],
  "applicationClaims": ["role", "gym_id", "membership_status"],
  "gymNeutralToken": {
    "gymId": "absent",
    "membershipStatus": "NONE"
  },
  "selectedGymToken": {
    "gymId": "required",
    "membershipStatus": "status returned for (sub, gym_id)"
  },
  "roles": ["CUSTOMER", "TRAINER", "ADMIN", "SUPER_ADMIN"],
  "membershipStatuses": ["NONE", "ACTIVE", "PAUSED", "EXPIRED"],
  "publicMethods": [
    "Register",
    "Login",
    "LoginWithGoogle",
    "RefreshToken",
    "VerifyEmail",
    "ResendEmailVerification"
  ],
  "protectedByDefault": true,
  "logoutIsProtected": true,
  "keyRotation": {
    "acceptedPublicKeys": ["current", "previous"],
    "minimumOverlap": "max-access-token-ttl"
  },
  "testing": {
    "committedPublicKeyFixture": true,
    "committedTestOnlySignerPrivateKey": true
  },
  "production": {
    "keySource": "secret-manager",
    "privateKeysCommitted": false
  },
  "gatewayValidation": [
    "algorithm",
    "signature",
    "issuer",
    "audience",
    "expiry",
    "issued-at",
    "jwt-id",
    "key-id"
  ]
}
